# En-têtes servis par Cloudflare Pages. Voir SPEC.md, section 10.

/*
  # Le doublon de la balise <meta robots> du gabarit, au niveau HTTP : la
  # balise ne protège que le HTML, cet en-tête couvre aussi le GeoJSON.
  X-Robots-Tag: noindex, nofollow
  # Le site n'est jamais chargé dans un cadre : rien n'a besoin de l'inclure.
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/_astro/*
  # Les noms portent une empreinte : un fichier de ce dossier ne change
  # jamais de contenu sous un même nom.
  Cache-Control: public, max-age=31536000, immutable

/donnees/*
  # La trace change à chaque build du pipeline, pas à chaque navigation.
  Cache-Control: public, max-age=3600
