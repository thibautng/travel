---
/**
 * Carte MapLibre. Voir SPEC.md, D3 et section 9.2.
 *
 * MapLibre n'est chargé qu'à la demande : le script observe le conteneur et
 * ne fait l'import dynamique qu'une fois la carte proche de l'écran. La
 * bibliothèque pèse à elle seule deux cents fois le reste du JavaScript du
 * site, et une page de journée peut être lue sans jamais la faire venir.
 *
 * Le fond est OpenFreeMap, comme le prévoit D4 pour le développement. Le
 * PMTiles auto-hébergé sur R2 arrive au lot 6.
 */
import { camps as campsDuVoyage, voyage as lireVoyage } from "../voyages";
import { urlMedia, empreinteTrace } from "../donnees";
import { getCollection } from "astro:content";

interface Props {
  /** Blocs numérotés du récit : `{ n, id }`, dans l'ordre du Markdown. */
  ancres?: { n: number; id: string }[];
  voyage: string;
  /** `ensemble` pour tout le voyage, `jour` pour une seule journée. */
  vue?: "ensemble" | "jour";
  jour?: string;
  hauteur?: string;
}
const { voyage, vue = "ensemble", jour, hauteur = "60vh", ancres = [] } = Astro.props;

// Les camps et les titres de journées sont passés au script en attributs de
// données plutôt que par un appel réseau : neuf lieux et vingt-trois titres
// pesent moins qu'une requête.
const v = lireVoyage(voyage);
const camps = campsDuVoyage(v).map((c) => ({
  nom: c.nom,
  lon: c.position.lon,
  lat: c.position.lat,
  du: c.du,
  au: c.au,
}));
const titres = Object.fromEntries(
  (await getCollection("journees", (e) => e.id.startsWith(`${voyage}/`))).map((e) => [
    e.data.date.toISOString().slice(0, 10),
    e.data.titre,
  ]),
);
---

<div
  class="carte"
  data-voyage={voyage}
  data-vue={vue}
  data-jour={jour}
  data-camps={JSON.stringify(camps)}
  data-titres={JSON.stringify(titres)}
  data-media={urlMedia("", voyage)}
  data-empreinte={empreinteTrace(voyage)}
  data-ancres={JSON.stringify(ancres)}
  style={`--hauteur:${hauteur}`}
>
  <p class="carte-temoin">Chargement de la carte…</p>
  <noscript>La carte demande JavaScript. Le récit, lui, se lit sans.</noscript>
</div>

<script>
  /**
   * Fond de carte. Section 10 et D4.
   *
   * Par defaut l'instance publique d'OpenFreeMap, sans cle ni inscription.
   * Si `PUBLIC_FOND_PMTILES` designe un fichier PMTiles sur R2, c'est lui qui
   * sert, et OpenFreeMap redevient ce que D4 en dit : un repli.
   *
   * La variable est lue a la construction, pas au chargement de la page : un
   * site publie sans elle n'embarque meme pas le protocole PMTiles.
   */
  const STYLE_FOND = "https://tiles.openfreemap.org/styles/positron";
  const FOND_PMTILES = import.meta.env.PUBLIC_FOND_PMTILES ?? "";

  async function afficher(conteneur: HTMLElement) {
    conteneur.dataset.etat = "chargement";
    const { Map, setWorkerUrl, NavigationControl, FullscreenControl, addProtocol } =
      await import("maplibre-gl");
    await import("maplibre-gl/dist/maplibre-gl.css");

    // MapLibre 6 decode les tuiles vectorielles dans un travailleur separe,
    // dont il deduit l'adresse de `import.meta.url` : il la cherche a cote de
    // son propre module. Une fois empaquete, ce module devient un morceau
    // compile, et le travailleur est demande a une adresse qui n'existe pas.
    // Le fichier repond alors 404, sans qu'aucune erreur ne remonte : la
    // source vectorielle reste indefiniment en cours de chargement pendant
    // que la couche raster, decodee sur le fil principal, s'affiche.
    //
    // On lui donne donc l'adresse. `?worker&url` et non `?url` : le fichier
    // travailleur importe lui-meme `./maplibre-gl-shared.mjs`, et une copie
    // brute laisse cet import sans cible. Il faut le faire empaqueter avec
    // ses dependances, ce que seule la forme `?worker` obtient.
    const { default: adresseTravailleur } = await import(
      "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url"
    );
    setWorkerUrl(adresseTravailleur);

    // Le protocole `pmtiles://` n'existe pas dans MapLibre : la bibliotheque
    // du meme nom l'ajoute, et traduit chaque demande de tuile en une requete
    // HTTP Range sur le fichier unique pose sur R2. Import dynamique, pour
    // qu'un site servi par OpenFreeMap ne le telecharge jamais.
    let style: any = STYLE_FOND;
    if (sombre()) {
      // OpenFreeMap ne publie pas de variante sombre de Positron. On charge
      // donc le style et l'on assombrit ses couches de fond.
      //
      // C'est le point le plus fragile du site : le style vient d'un tiers et
      // peut changer sans preavis. En cas d'echec, on retombe sur le style
      // clair, qui reste lisible - c'est laid, ce n'est pas casse.
      try {
        const reponse = await fetch(STYLE_FOND);
        if (reponse.ok) style = assombrir(await reponse.json());
      } catch {
        style = STYLE_FOND;
      }
    }
    if (FOND_PMTILES) {
      const { Protocol } = await import("pmtiles");
      addProtocol("pmtiles", new Protocol().tile);
      style = styleProtomaps(FOND_PMTILES);
    }

    const carte = new Map({
      container: conteneur,
      style,
      // Repli seulement : le cadrage reel vient de l'emprise de la trace.
      center: [11, 46.5],
      zoom: 4,
      attributionControl: { compact: true },
      // Le site se lit d'abord au doigt : la rotation gêne plus qu'elle ne sert.
      pitchWithRotate: false,
      dragRotate: false,
    });
    carte.touchZoomRotate.disableRotation();
    carte.addControl(new NavigationControl({ showCompass: false }), "top-right");
    carte.addControl(new FullscreenControl(), "top-right");
    const temoin = conteneur.querySelector<HTMLElement>(".carte-temoin");
    const dire = (texte: string) => {
      if (temoin) temoin.textContent = texte;
    };
    dire("Style chargé, tuiles en cours…");

    let tuiles = 0;
    carte.on("dataloading", () => {
      tuiles += 1;
      dire(`Chargement des tuiles… (${tuiles})`);
    });

    carte.on("load", () => {
      conteneur.dataset.etat = "pret";
      carte.resize();
    });

    // MapLibre fige la taille de sa toile a la construction. Si le conteneur
    // n'a pas encore sa hauteur a cet instant, ce qui arrive quand la feuille
    // de style du composant est injectee apres le script, la toile reste a
    // zero et rien ne s'affiche, alors que la carte fonctionne. On suit donc
    // la taille du conteneur.
    const suivi = new ResizeObserver(() => carte.resize());
    suivi.observe(conteneur);
    // Un fond injoignable ou un style invalide ne doit pas laisser un
    // rectangle gris muet : la page le dit.
    let echecs = 0;
    carte.on("error", (evenement: any) => {
      echecs += 1;
      const message = evenement.error?.message ?? "erreur inconnue";
      console.error("carte :", message);
      // Le premier echec suffit a nommer la cause ; les suivants ne font que
      // la repeter, et noieraient le conteneur.
      if (echecs === 1) signaler(conteneur, message);
    });

    carte.on("load", () => {
      dessiner(carte, conteneur)
        .then(() => temoin?.remove())
        .catch((erreur: unknown) => {
          signaler(conteneur, erreur instanceof Error ? erreur.message : String(erreur));
        });
    });
    return carte;
  }

  /**
   * Style clair pour un fichier PMTiles produit par protomaps.
   *
   * Ecrit a la main plutot qu'apporte par `protomaps-themes-base` : le site
   * n'a besoin que de six couches, et la trace doit rester lisible par-dessus
   * un fond volontairement pale. Les couleurs sont celles du gabarit.
   */
  function styleProtomaps(url: string): any {
    const source = { pmtiles: { type: "vector", url: `pmtiles://${url}`, attribution: "© OpenStreetMap, Protomaps" } };
    const couche = (id: string, couleur: string, filtre?: any[]) => ({
      id,
      type: "fill",
      source: "pmtiles",
      "source-layer": id === "fond" ? "earth" : id,
      ...(filtre ? { filter: filtre } : {}),
      paint: { "fill-color": couleur },
    });
    return {
      version: 8,
      glyphs: "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
      sources: source,
      layers: [
        { id: "papier", type: "background", paint: { "background-color": "#f4f1ec" } },
        couche("fond", "#eae5dd"),
        couche("landuse", "#e6e8de"),
        couche("water", "#cfd9de"),
        {
          id: "routes",
          type: "line",
          source: "pmtiles",
          "source-layer": "roads",
          paint: {
            "line-color": "#dcd6cc",
            "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 12, 1.6],
          },
        },
        {
          id: "frontieres",
          type: "line",
          source: "pmtiles",
          "source-layer": "boundaries",
          paint: { "line-color": "#c9c2b8", "line-dasharray": [3, 2], "line-width": 0.8 },
        },
        {
          id: "noms",
          type: "symbol",
          source: "pmtiles",
          "source-layer": "places",
          layout: {
            "text-field": ["get", "name"],
            "text-font": ["Noto Sans Regular"],
            "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 10, 13],
          },
          paint: { "text-color": "#6f665e", "text-halo-color": "#f4f1ec", "text-halo-width": 1.4 },
        },
      ],
    };
  }

  /** Le lecteur a-t-il demande le theme sombre ? */
  function sombre(): boolean {
    return window.matchMedia?.("(prefers-color-scheme: dark)").matches ?? false;
  }

  /**
   * Assombrit un style MapLibre clair.
   *
   * Trois familles de couches, trois traitements. Le fond et les surfaces
   * prennent la couleur du papier de la carte ; les traits, celle de la
   * grille ; les etiquettes, l'encre discrete avec un halo de fond. L'eau et
   * la vegetation gardent une nuance, sans quoi une carte de lacs devient une
   * carte de rien.
   *
   * Les couleurs viennent des jetons : le fond de carte suit la meme palette
   * que la page qui l'entoure.
   */
  function assombrir(style: any): any {
    const papier = lireCouleur("--map", "#1b2124");
    const grille = lireCouleur("--grid", "#242c2f");
    const encre = lireCouleur("--muted", "#9aa29d");
    const eau = "#16242e";
    const vegetation = "#1b2620";

    const teinte = (id: string) => {
      if (/water|ocean|sea|river|lake/i.test(id)) return eau;
      if (/park|wood|forest|grass|green|landcover/i.test(id)) return vegetation;
      return null;
    };

    for (const couche of style.layers ?? []) {
      const peinture = (couche.paint ??= {});
      const particuliere = teinte(couche.id ?? "");
      if (couche.type === "background") {
        peinture["background-color"] = papier;
      } else if (couche.type === "fill") {
        peinture["fill-color"] = particuliere ?? papier;
        if (peinture["fill-outline-color"]) peinture["fill-outline-color"] = grille;
      } else if (couche.type === "line") {
        peinture["line-color"] = particuliere ?? grille;
      } else if (couche.type === "symbol") {
        peinture["text-color"] = encre;
        peinture["text-halo-color"] = papier;
        peinture["icon-opacity"] = 0.5;
      } else if (couche.type === "fill-extrusion") {
        peinture["fill-extrusion-color"] = grille;
      }
    }
    return style;
  }

  /**
   * Rayon des pastilles numerotees : onze au repos, quinze pour l'active.
   * L'etat actif est unique et persiste, sans retour au repos automatique.
   */
  function rayonAncres(actif: string | null, ancres: { n: number; id: string }[]): any {
    if (!actif || ancres.length === 0) return 11;
    return ["case", ["==", ["get", "id"], actif], 15, 11];
  }

  /**
   * Lit un jeton de couleur dans la feuille de style.
   *
   * Les couleurs de la carte suivent le theme : codees en dur, elles ne
   * pourraient pas changer avec lui.
   */
  function lireCouleur(jeton: string, repli: string): string {
    const valeur = getComputedStyle(document.documentElement).getPropertyValue(jeton).trim();
    return valeur || repli;
  }

  /**
   * Emprise des geometries, pour le cadrage. Restreinte a une journee quand
   * `jour` est donne : c'est ce qui permet de recentrer au fil de la lecture.
   */
  function emprise(trace: any, jour?: string | null): [[number, number], [number, number]] {
    let ouest = 180, sud = 90, est = -180, nord = -90;
    const point = ([x, y]: number[]) => {
      if (x < ouest) ouest = x;
      if (x > est) est = x;
      if (y < sud) sud = y;
      if (y > nord) nord = y;
    };
    for (const entite of trace.features ?? []) {
      const g = entite.geometry;
      if (!g) continue;
      if (jour && entite.properties?.jour !== jour) continue;
      if (g.type === "Point") point(g.coordinates);
      else if (g.type === "LineString") g.coordinates.forEach(point);
    }
    return [
      [ouest, sud],
      [est, nord],
    ];
  }

  /**
   * Les pastilles de medias. Aucune de ces deux teintes n’est une couleur de
   * mode : la pastille ne doit pas se confondre avec le trace qui la porte.
   * La legende reprend les memes valeurs.
   */
  const COULEUR_PHOTO = "#ffffff";  // volontairement fixe : c'est une perle claire sur la trace.
  const COULEUR_VIDEO = "#8c4a6b";

  /** Les six modes, lus dans les jetons pour suivre le theme. */
  const MODES = ["route", "marche", "velo", "bateau", "train", "telepherique"];
  function couleurParMode(): any {
    const expression: any[] = ["match", ["get", "mode"]];
    for (const mode of MODES) {
      expression.push(mode, lireCouleur(`--mode-${mode}`, "#4a3b2e"));
    }
    expression.push(lireCouleur("--mode-route", "#4a3b2e"));
    return expression;
  }

  /** Les camps de base, en marqueurs distincts. Section 9.2. */
  function poserCamps(carte: any, conteneur: HTMLElement) {
    const camps = JSON.parse(conteneur.dataset.camps ?? "[]");
    if (camps.length === 0) return;

    carte.addSource("camps", {
      type: "geojson",
      data: {
        type: "FeatureCollection",
        features: camps.map((c: any) => ({
          type: "Feature",
          geometry: { type: "Point", coordinates: [c.lon, c.lat] },
          properties: { nom: c.nom, du: c.du, au: c.au },
        })),
      },
    });

    carte.addLayer({
      id: "camps",
      type: "circle",
      source: "camps",
      paint: {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 5, 5, 12, 8],
        "circle-color": lireCouleur("--ink", "#1e2422"),
        "circle-stroke-width": 2.5,
        "circle-stroke-color": lireCouleur("--panel", "#ffffff"),
      },
    });

    carte.addLayer({
      id: "camps-nom",
      type: "symbol",
      source: "camps",
      layout: {
        "text-field": ["get", "nom"],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 10, 13],
        "text-offset": [0, 1.1],
        "text-anchor": "top",
        "text-allow-overlap": false,
      },
      paint: {
        "text-color": lireCouleur("--ink", "#1e2422"),
        "text-halo-color": lireCouleur("--bg", "#f2f3ef"),
        "text-halo-width": 1.6,
      },
    });
  }

  /**
   * Un clic sur une trace ou sur une pastille mene a la journee.
   * Section 9.2 : les journees sont cliquables.
   *
   * Sauf sur la page d'une journee, ou l'on y est deja : le clic sur une
   * pastille y designe le media, et la page va le chercher dans le recit.
   */
  function rendreCliquable(carte: any, conteneur: HTMLElement) {
    const voyage = conteneur.dataset.voyage!;
    const titres: Record<string, string> = JSON.parse(conteneur.dataset.titres ?? "{}");
    const surPlace = conteneur.dataset.vue === "jour";

    // Seules les couches reellement posees : `ancres` n'existe que sur une page
    // de journee dont le recit numerote des blocs, et interroger une couche
    // absente jette une erreur qui arrete la carte entiere.
    const existantes = (liste: string[]) => liste.filter((c) => carte.getLayer(c));

    for (const couche of existantes([
      "trace",
      "photos",
      "videos",
      "photos-posees",
      "videos-posees",
      "ancres",
    ])) {
      carte.on("click", couche, (e: any) => {
        const proprietes = e.features?.[0]?.properties ?? {};
        if (surPlace) {
          if (proprietes.id) {
            conteneur.dispatchEvent(
              new CustomEvent("carte:media", {
                bubbles: true,
                detail: { id: proprietes.id },
              }),
            );
          }
          return;
        }
        if (proprietes.jour) {
          window.location.href = `/voyages/${voyage}/jours/${proprietes.jour}/`;
        }
      });
    }

    // Un seul gestionnaire, et non un par couche : une pastille se pose sur
    // la trace, donc les deux couches repondent au meme survol. Avec un
    // gestionnaire par couche, celui de la trace ecrasait celui de la
    // pastille et la vignette n'apparaissait jamais. Ici l'ordre des couches
    // interrogees fait la priorite.
    const COUCHES = existantes([
      "ancres",
      "photos",
      "videos",
      "photos-posees",
      "videos-posees",
      "camps",
      "trace",
    ]);
    carte.on("mousemove", (e: any) => {
      const trouvees = carte.queryRenderedFeatures(e.point, { layers: COUCHES });
      if (trouvees.length === 0) {
        carte.getCanvas().style.cursor = "";
        montrerEtiquette(conteneur, null);
        return;
      }
      // La premiere couche de la liste qui repond l'emporte.
      const entite =
        COUCHES.map((c) => trouvees.find((f: any) => f.layer.id === c)).find(Boolean) ??
        trouvees[0];
      const p = entite.properties ?? {};
      carte.getCanvas().style.cursor = "pointer";
      if (p.nom) {
        montrerEtiquette(conteneur, p.nom);
      } else if (p.jour) {
        const titre = titres[p.jour] ?? p.jour;
        const texte = p.type === "video" ? `${titre} · vidéo` : titre;
        montrerEtiquette(conteneur, texte, p.vignette);
      }
    });
  }

  /**
   * Etiquette discrete en bas de carte, plutot qu'une bulle qui masque le
   * trace qu'on est en train de lire. Une pastille de photo y montre sa
   * vignette : c'est ce que la carte a de plus utile a dire au survol.
   */
  function montrerEtiquette(
    conteneur: HTMLElement,
    texte: string | null,
    vignette?: string,
  ) {
    let bloc = conteneur.querySelector<HTMLElement>(".carte-etiquette");
    if (!texte) {
      bloc?.remove();
      return;
    }
    if (!bloc) {
      bloc = document.createElement("div");
      bloc.className = "carte-etiquette";
      conteneur.append(bloc);
    }
    bloc.innerHTML = "";
    if (vignette) {
      const image = document.createElement("img");
      image.src = `${conteneur.dataset.media}${vignette}`;
      image.alt = "";
      bloc.append(image);
    }
    const legende = document.createElement("span");
    legende.textContent = texte;
    bloc.append(legende);
  }

  async function dessiner(carte: any, conteneur: HTMLElement): Promise<number> {
    const voyage = conteneur.dataset.voyage!;
    // La page d'une journee ne charge que la sienne : le fichier complet
    // pese 246 Ko comprimes, pour une carte cadree sur un seul jour.
    const jourSeul = conteneur.dataset.vue === "jour" ? conteneur.dataset.jour : null;
    // L'empreinte change avec la trace : sans elle, un navigateur garderait
    // l'ancienne version une heure durant, meme apres rechargement force.
    const version = conteneur.dataset.empreinte ?? "";
    const adresse = jourSeul
      ? `/donnees/${voyage}/jours/${jourSeul}.geojson?v=${version}`
      : `/donnees/${voyage}/trace.geojson?v=${version}`;
    const reponse = await fetch(adresse);
    if (!reponse.ok) {
      throw new Error(`trace indisponible (HTTP ${reponse.status})`);
    }
    const trace = await reponse.json();
    carte.addSource("trace", { type: "geojson", data: trace });

    const lignes: any = [
      "all",
      ["==", ["geometry-type"], "LineString"],
    ];
    const epaisseur = ["interpolate", ["linear"], ["zoom"], 5, 3, 10, 5, 14, 7];

    // La trace des autres journees, sous le reste et en gris clair. Elle
    // reste visible : le lecteur d'une journee veut voir ou elle se situe
    // dans le voyage. Sans jour actif, cette couche ne montre rien.
    carte.addLayer({
      id: "trace-fond",
      type: "line",
      source: "trace",
      filter: ["all", ...lignes.slice(1), ["==", "1", "0"]],
      layout: { "line-cap": "round", "line-join": "round" },
      paint: {
        "line-color": "#b4aca2",
        "line-opacity": 0.75,
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.5, 10, 2.5, 14, 3.5],
      },
    });

    // Un contour clair sous la trace. Le fond Positron est fait de traits
    // gris fins, frontieres et cours d'eau, dans lesquels une ligne coloree
    // se perd : ce halo lui degage sa place.
    carte.addLayer({
      id: "trace-contour",
      type: "line",
      source: "trace",
      filter: lignes,
      layout: { "line-cap": "round", "line-join": "round" },
      paint: {
        "line-color": lireCouleur("--panel", "#ffffff"),
        "line-opacity": 0.9,
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 6, 10, 9, 14, 12],
      },
    });

    carte.addLayer({
      id: "trace",
      type: "line",
      source: "trace",
      filter: lignes,
      layout: { "line-cap": "round", "line-join": "round" },
      paint: {
        // La couleur vient des jetons CSS et non du pipeline : elle doit
        // changer avec le theme, ce qu'une valeur figee dans le GeoJSON ne
        // saurait pas faire.
        "line-color": couleurParMode(),
        "line-opacity": 0.95,
        "line-width": epaisseur,
      },
    });

    // Section 9.2 : les positions suspectes ne sont pas affichees par defaut.
    // Deux couches et non une : la photo porte une vignette au survol, la
    // video n'en a pas. Une seule couleur pour les deux faisait passer les
    // videos pour des photos dont la vignette manquait.
    const pastille = (couleur: string) => ({
      "circle-radius": ["interpolate", ["linear"], ["zoom"], 5, 2.5, 10, 4, 14, 6],
      "circle-color": couleur,
      // Un cercle blanc cercle de sombre : aucune couleur de mode ne lui
      // ressemble, la pastille se lit sur un trace de marche comme sur une
      // route.
      "circle-stroke-width": 1.4,
      "circle-stroke-color": lireCouleur("--ink", "#1e2422"),
      "circle-opacity": 0.95,
    });
    // Section 9.2 : pastille pleine pour une position mesurée, creuse pour une
    // position reconstituée. Une position basse qu’aucun mécanisme n’a su
    // replacer n’est pas montrée : elle serait un point posé au hasard.
    const RECONSTITUEES = ["posee", "interpolee", "heritee"];
    const point = (type: string, mesuree: boolean) => [
      "all",
      ["==", ["geometry-type"], "Point"],
      ["==", ["get", "type"], type],
      mesuree
        ? ["==", ["get", "fiabilite"], "haute"]
        : [
            "all",
            ["!=", ["get", "fiabilite"], "haute"],
            ["in", ["get", "origine_position"], ["literal", RECONSTITUEES]],
          ],
    ];
    const creuse = (couleur: string) => ({
      ...pastille(couleur),
      "circle-color": "rgba(255, 255, 255, 0)",
      "circle-stroke-color": couleur === COULEUR_PHOTO ? "#6f665e" : couleur,
    });

    // Les creuses d’abord : une pastille mesurée prime au survol comme au
    // rendu, l’ordre d’ajout faisant la superposition.
    const pastilles: [string, any[], any][] = [
      ["videos-posees", point("video", false), creuse(COULEUR_VIDEO)],
      ["photos-posees", point("photo", false), creuse(COULEUR_PHOTO)],
      ["videos", point("video", true), pastille(COULEUR_VIDEO)],
      ["photos", point("photo", true), pastille(COULEUR_PHOTO)],
    ];
    for (const [id, filtre, peinture] of pastilles) {
      FILTRES.set(id, filtre);
      carte.addLayer({ id, type: "circle", source: "trace", filter: filtre, paint: peinture });
    }

    // Les blocs numerotes du recit, en pastilles portant leur chiffre. C'est
    // le lien visible entre le texte et la carte : il se voit sans survol,
    // donc au doigt et au clavier, ce que l'anneau seul ne permettait pas.
    const ancres: { n: number; id: string }[] = JSON.parse(conteneur.dataset.ancres ?? "[]");
    if (ancres.length > 0) {
      const identifiants = ancres.map((a) => a.id);
      const numero: any[] = ["match", ["get", "id"]];
      for (const a of ancres) numero.push(a.id, String(a.n));
      numero.push("");

      carte.addLayer({
        id: "ancres",
        type: "circle",
        source: "trace",
        filter: ["in", ["get", "id"], ["literal", identifiants]],
        paint: {
          "circle-radius": rayonAncres(null, ancres),
          "circle-color": lireCouleur("--accent", "#d1491f"),
          "circle-stroke-width": 2,
          "circle-stroke-color": lireCouleur("--panel", "#ffffff"),
        },
      });
      carte.addLayer({
        id: "ancres-numero",
        type: "symbol",
        source: "trace",
        filter: ["in", ["get", "id"], ["literal", identifiants]],
        layout: {
          "text-field": numero,
          "text-font": ["Noto Sans Regular"],
          "text-size": 12,
          "text-allow-overlap": true,
        },
        paint: { "text-color": lireCouleur("--panel", "#ffffff") },
      });

      conteneur.addEventListener("carte:ancre", (evenement) => {
        const n = (evenement as CustomEvent).detail?.n ?? null;
        const actif = ancres.find((a) => String(a.n) === String(n)) ?? null;
        carte.setPaintProperty("ancres", "circle-radius", rayonAncres(actif?.id ?? null, ancres));
      });
    }

    // Le media que le recit est en train de montrer, cercle d'un anneau.
    // Filtre vide au depart : la couche existe, elle ne montre rien.
    carte.addLayer({
      id: "media-actif",
      type: "circle",
      source: "trace",
      filter: ["==", ["get", "id"], ""],
      paint: {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 5, 6, 10, 9, 14, 12],
        "circle-color": "rgba(255, 255, 255, 0)",
        "circle-stroke-width": 3,
        "circle-stroke-color": "#c0562a",
      },
    });

    conteneur.addEventListener("carte:media-actif", (evenement) => {
      const id = (evenement as CustomEvent).detail?.id ?? "";
      carte.setFilter("media-actif", ["==", ["get", "id"], id]);
    });

    const [[ouest, sud], [est, nord]] = emprise(trace);
    if (ouest > est || sud > nord) {
      throw new Error("trace sans geometrie exploitable");
    }
    poserCamps(carte, conteneur);
    rendreCliquable(carte, conteneur);

    // Une journee demandee des le depart : page de journee, ou lecteur ouvert
    // sur une date. Le cadrage initial ne s'anime pas, il n'y a rien a suivre.
    const initial = conteneur.dataset.vue === "jour" ? conteneur.dataset.jour : null;
    montrerJour(carte, conteneur, trace, initial ?? null, false);

    // Le theme peut changer pendant la lecture, sans rechargement : les
    // couleurs de nos couches sont relues, celles du fond ne le sont pas -
    // reconstruire le style entier coupe la carte une seconde, et le systeme
    // ne change pas de theme dix fois par heure.
    window.matchMedia?.("(prefers-color-scheme: dark)").addEventListener("change", () => {
      carte.setPaintProperty("trace", "line-color", couleurParMode());
      carte.setPaintProperty("trace-contour", "line-color", lireCouleur("--panel", "#ffffff"));
      for (const couche of ["photos", "photos-posees"]) {
        if (!carte.getLayer(couche)) continue;
        carte.setPaintProperty(couche, "circle-stroke-color", lireCouleur("--ink", "#1e2422"));
      }
      if (carte.getLayer("ancres")) {
        carte.setPaintProperty("ancres", "circle-color", lireCouleur("--accent", "#d1491f"));
        carte.setPaintProperty("ancres", "circle-stroke-color", lireCouleur("--panel", "#ffffff"));
      }
      if (carte.getLayer("camps")) {
        carte.setPaintProperty("camps", "circle-color", lireCouleur("--ink", "#1e2422"));
        carte.setPaintProperty("camps", "circle-stroke-color", lireCouleur("--panel", "#ffffff"));
      }
    });

    // Le pilotage vient du dehors : le lecteur jour par jour et la page de
    // journee poussent une date, la carte ne sait rien de leurs commandes.
    conteneur.addEventListener("carte:jour", (evenement) => {
      const demande = (evenement as CustomEvent).detail?.jour ?? null;
      montrerJour(carte, conteneur, trace, demande, true);
    });

    return trace.features?.length ?? 0;
  }

  /**
   * Met une journee en avant, ou la releve quand `jour` est nul.
   *
   * Les couches ne sont pas reconstruites, seuls leurs filtres changent :
   * MapLibre reevalue une expression sans retoucher a la source, ce qui rend
   * le defilement des vingt-trois journees instantane.
   */
  function montrerJour(
    carte: any,
    conteneur: HTMLElement,
    trace: any,
    jour: string | null,
    anime: boolean,
  ) {
    const estLigne = ["==", ["geometry-type"], "LineString"];
    const duJour = jour ? ["==", ["get", "jour"], jour] : ["literal", true];
    const desAutres = jour ? ["!=", ["get", "jour"], jour] : ["literal", false];

    for (const couche of ["trace", "trace-contour"]) {
      carte.setFilter(couche, ["all", estLigne, duJour]);
    }
    carte.setFilter("trace-fond", ["all", estLigne, desAutres]);

    // Les pastilles suivent : montrer les photos des vingt-deux autres
    // journees pendant qu'on en lit une seule brouille la lecture.
    for (const [couche, origine] of FILTRES) {
      carte.setFilter(couche, ["all", ...origine.slice(1), duJour]);
    }

    conteneur.dataset.jourActif = jour ?? "";
    const [[ouest, sud], [est, nord]] = emprise(trace, jour);
    if (ouest > est || sud > nord) return;
    carte.fitBounds(
      [
        [ouest, sud],
        [est, nord],
      ],
      { padding: 36, animate: anime, duration: 700, maxZoom: 14 },
    );
  }

  /**
   * Filtres des couches de pastilles tels que posees, avant restriction a une
   * journee. Retenus a la creation : les relire dans MapLibre rendrait le
   * filtre deja restreint, et la restriction s'empilerait a chaque changement
   * de jour.
   */
  const FILTRES = new Map<string, any[]>();

  /** Affiche l'echec dans le conteneur, plutot que dans la seule console. */
  function signaler(conteneur: HTMLElement, message: string) {
    conteneur.dataset.etat = "erreur";
    if (conteneur.querySelector(".carte-erreur")) return;
    const bloc = document.createElement("p");
    bloc.className = "carte-erreur";
    bloc.textContent = `La carte n'a pas pu s'afficher : ${message}`;
    conteneur.append(bloc);
    console.error("carte :", message);
  }

  const conteneurs = Array.from(document.querySelectorAll<HTMLElement>(".carte"));
  if (conteneurs.length > 0) {
    const observateur = new IntersectionObserver(
      (entrees) => {
        for (const entree of entrees) {
          if (!entree.isIntersecting) continue;
          observateur.unobserve(entree.target);
          const cible = entree.target as HTMLElement;
          afficher(cible).catch((erreur: unknown) => {
            signaler(cible, erreur instanceof Error ? erreur.message : String(erreur));
          });
        }
      },
      // Un peu d'avance, pour que la carte soit prête à l'arrivée du regard.
      { rootMargin: "300px" },
    );
    conteneurs.forEach((c) => observateur.observe(c));
  }
</script>

<style is:global>
  .carte {
    height: var(--hauteur, 60vh);
    width: 100%;
    border-radius: 3px;
    background: var(--trait);
    position: relative;
  }
  .carte-etiquette {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    z-index: 2;
    margin: 0;
    /* En colonne et non en ligne : c’est la vignette qui fixe la largeur du
       bloc, et le titre passe dessous en revenant à la ligne. Cot’ à côte,
       un titre long étirait l’étiquette sur toute la carte. */
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.35rem;
    width: max-content;
    padding: 0.35rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.92);
    color: #2b2723;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.82rem;
    line-height: 1.3;
    pointer-events: none;
    max-width: calc(100% - 1.2rem);
  }
  /* Sans vignette — le nom d’un camping, un survol de tracé — l’étiquette
     reste la bande discrète d’avant. */
  .carte-etiquette:not(:has(img)) {
    padding: 0.3rem 0.6rem;
  }
  .carte-etiquette span {
    /* La largeur de la vignette borne le titre : au-delà, il revient à la
       ligne au lieu d’élargir le bloc. */
    max-width: 240px;
    text-wrap: pretty;
  }
  @media (max-width: 30rem) {
    .carte-etiquette img {
      width: 152px;
      height: 101px;
    }
    .carte-etiquette span {
      max-width: 152px;
    }
  }
  .carte-etiquette img {
    display: block;
    width: 240px;
    height: 160px;
    object-fit: cover;
    border-radius: 2px;
  }

  .carte-temoin,
  .carte-erreur,
  .carte noscript {
    position: absolute;
    inset: 0;
    /* MapLibre insere sa toile apres ces elements : sans cela, elle les
       recouvre et le message reste invisible sous la carte. */
    z-index: 2;
    pointer-events: none;
    margin: 0;
    background: color-mix(in srgb, var(--fond) 82%, transparent);
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
    color: var(--discret);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9rem;
  }
  /* L'attribution doit rester lisible et cessible, sans occuper le quart de
     la carte sur un telephone. */
  .maplibregl-ctrl-attrib,
  .maplibregl-ctrl-attrib a {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.62rem;
    line-height: 1.35;
  }
  .maplibregl-ctrl-attrib.maplibregl-compact {
    padding: 0 1.4rem 0 0.4rem;
    min-height: 1.35rem;
  }
  .maplibregl-ctrl-attrib-button {
    transform: scale(0.85);
  }
</style>
