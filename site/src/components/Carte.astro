---
/**
 * Carte MapLibre. Voir SPEC.md, D3 et section 9.2.
 *
 * MapLibre n'est chargé qu'à la demande : le script observe le conteneur et
 * ne fait l'import dynamique qu'une fois la carte proche de l'écran. La
 * bibliothèque pèse à elle seule deux cents fois le reste du JavaScript du
 * site, et une page de journée peut être lue sans jamais la faire venir.
 *
 * Le fond est OpenFreeMap, comme le prévoit D4 pour le développement. Le
 * PMTiles auto-hébergé sur R2 arrive au lot 6.
 */
import { camps as campsDuVoyage, voyage as lireVoyage } from "../voyages";
import { getCollection } from "astro:content";

interface Props {
  voyage: string;
  /** `ensemble` pour tout le voyage, `jour` pour une seule journée. */
  vue?: "ensemble" | "jour";
  jour?: string;
  hauteur?: string;
}
const { voyage, vue = "ensemble", jour, hauteur = "60vh" } = Astro.props;

// Les camps et les titres de journées sont passés au script en attributs de
// données plutôt que par un appel réseau : neuf lieux et vingt-trois titres
// pesent moins qu'une requête.
const v = lireVoyage(voyage);
const camps = campsDuVoyage(v).map((c) => ({
  nom: c.nom,
  lon: c.position.lon,
  lat: c.position.lat,
  du: c.du,
  au: c.au,
}));
const titres = Object.fromEntries(
  (await getCollection("journees", (e) => e.id.startsWith(`${voyage}/`))).map((e) => [
    e.data.date.toISOString().slice(0, 10),
    e.data.titre,
  ]),
);
---

<div
  class="carte"
  data-voyage={voyage}
  data-vue={vue}
  data-jour={jour}
  data-camps={JSON.stringify(camps)}
  data-titres={JSON.stringify(titres)}
  style={`--hauteur:${hauteur}`}
>
  <p class="carte-temoin">Chargement de la carte…</p>
  <noscript>La carte demande JavaScript. Le récit, lui, se lit sans.</noscript>
</div>

<script>
  const STYLE_FOND = "https://tiles.openfreemap.org/styles/positron";

  async function afficher(conteneur: HTMLElement) {
    conteneur.dataset.etat = "chargement";
    const { Map, setWorkerUrl, NavigationControl, FullscreenControl } =
      await import("maplibre-gl");
    await import("maplibre-gl/dist/maplibre-gl.css");

    // MapLibre 6 decode les tuiles vectorielles dans un travailleur separe,
    // dont il deduit l'adresse de `import.meta.url` : il la cherche a cote de
    // son propre module. Une fois empaquete, ce module devient un morceau
    // compile, et le travailleur est demande a une adresse qui n'existe pas.
    // Le fichier repond alors 404, sans qu'aucune erreur ne remonte : la
    // source vectorielle reste indefiniment en cours de chargement pendant
    // que la couche raster, decodee sur le fil principal, s'affiche.
    //
    // On lui donne donc l'adresse. `?worker&url` et non `?url` : le fichier
    // travailleur importe lui-meme `./maplibre-gl-shared.mjs`, et une copie
    // brute laisse cet import sans cible. Il faut le faire empaqueter avec
    // ses dependances, ce que seule la forme `?worker` obtient.
    const { default: adresseTravailleur } = await import(
      "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url"
    );
    setWorkerUrl(adresseTravailleur);

    const carte = new Map({
      container: conteneur,
      style: STYLE_FOND,
      // Repli seulement : le cadrage reel vient de l'emprise de la trace.
      center: [11, 46.5],
      zoom: 4,
      attributionControl: { compact: true },
      // Le site se lit d'abord au doigt : la rotation gêne plus qu'elle ne sert.
      pitchWithRotate: false,
      dragRotate: false,
    });
    carte.touchZoomRotate.disableRotation();
    carte.addControl(new NavigationControl({ showCompass: false }), "top-right");
    carte.addControl(new FullscreenControl(), "top-right");
    const temoin = conteneur.querySelector<HTMLElement>(".carte-temoin");
    const dire = (texte: string) => {
      if (temoin) temoin.textContent = texte;
    };
    dire("Style chargé, tuiles en cours…");

    let tuiles = 0;
    carte.on("dataloading", () => {
      tuiles += 1;
      dire(`Chargement des tuiles… (${tuiles})`);
    });

    carte.on("load", () => {
      conteneur.dataset.etat = "pret";
      carte.resize();
    });

    // MapLibre fige la taille de sa toile a la construction. Si le conteneur
    // n'a pas encore sa hauteur a cet instant, ce qui arrive quand la feuille
    // de style du composant est injectee apres le script, la toile reste a
    // zero et rien ne s'affiche, alors que la carte fonctionne. On suit donc
    // la taille du conteneur.
    const suivi = new ResizeObserver(() => carte.resize());
    suivi.observe(conteneur);
    // Un fond injoignable ou un style invalide ne doit pas laisser un
    // rectangle gris muet : la page le dit.
    let echecs = 0;
    carte.on("error", (evenement: { error?: Error }) => {
      echecs += 1;
      const message = evenement.error?.message ?? "erreur inconnue";
      console.error("carte :", message);
      // Le premier echec suffit a nommer la cause ; les suivants ne font que
      // la repeter, et noieraient le conteneur.
      if (echecs === 1) signaler(conteneur, message);
    });

    const voyage = conteneur.dataset.voyage!;
    carte.on("load", () => {
      dessiner(carte, voyage)
        .then(() => temoin?.remove())
        .catch((erreur: unknown) => {
          signaler(conteneur, erreur instanceof Error ? erreur.message : String(erreur));
        });
    });
    return carte;
  }

  /** Emprise de toutes les geometries, pour le cadrage initial. */
  function emprise(trace: any): [[number, number], [number, number]] {
    let ouest = 180, sud = 90, est = -180, nord = -90;
    const point = ([x, y]: number[]) => {
      if (x < ouest) ouest = x;
      if (x > est) est = x;
      if (y < sud) sud = y;
      if (y > nord) nord = y;
    };
    for (const entite of trace.features ?? []) {
      const g = entite.geometry;
      if (!g) continue;
      if (g.type === "Point") point(g.coordinates);
      else if (g.type === "LineString") g.coordinates.forEach(point);
    }
    return [
      [ouest, sud],
      [est, nord],
    ];
  }

  /** Les camps de base, en marqueurs distincts. Section 9.2. */
  function poserCamps(carte: any, conteneur: HTMLElement) {
    const camps = JSON.parse(conteneur.dataset.camps ?? "[]");
    if (camps.length === 0) return;

    carte.addSource("camps", {
      type: "geojson",
      data: {
        type: "FeatureCollection",
        features: camps.map((c: any) => ({
          type: "Feature",
          geometry: { type: "Point", coordinates: [c.lon, c.lat] },
          properties: { nom: c.nom, du: c.du, au: c.au },
        })),
      },
    });

    carte.addLayer({
      id: "camps",
      type: "circle",
      source: "camps",
      paint: {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 5, 5, 12, 8],
        "circle-color": "#2b2723",
        "circle-stroke-width": 2.5,
        "circle-stroke-color": "#ffffff",
      },
    });

    carte.addLayer({
      id: "camps-nom",
      type: "symbol",
      source: "camps",
      // Les noms n'apparaissent qu'une fois la carte assez zoomee : a
      // l'echelle du voyage entier, huit etiquettes se chevauchent.
      minzoom: 7,
      layout: {
        "text-field": ["get", "nom"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-offset": [0, 1.2],
        "text-anchor": "top",
        "text-allow-overlap": false,
      },
      paint: {
        "text-color": "#2b2723",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6,
      },
    });
  }

  /**
   * Un clic sur une trace ou sur une pastille mene a la journee.
   * Section 9.2 : les journees sont cliquables.
   */
  function rendreCliquable(carte: any, conteneur: HTMLElement) {
    const voyage = conteneur.dataset.voyage!;
    const titres: Record<string, string> = JSON.parse(conteneur.dataset.titres ?? "{}");

    for (const couche of ["trace", "photos"]) {
      carte.on("click", couche, (e: any) => {
        const jour = e.features?.[0]?.properties?.jour;
        if (jour) window.location.href = `/voyages/${voyage}/jours/${jour}/`;
      });
      carte.on("mouseenter", couche, (e: any) => {
        carte.getCanvas().style.cursor = "pointer";
        const jour = e.features?.[0]?.properties?.jour;
        if (jour) montrerEtiquette(conteneur, titres[jour] ?? jour);
      });
      carte.on("mouseleave", couche, () => {
        carte.getCanvas().style.cursor = "";
        montrerEtiquette(conteneur, null);
      });
    }

    carte.on("mouseenter", "camps", (e: any) => {
      carte.getCanvas().style.cursor = "pointer";
      const p = e.features?.[0]?.properties;
      if (p) montrerEtiquette(conteneur, p.nom);
    });
    carte.on("mouseleave", "camps", () => {
      carte.getCanvas().style.cursor = "";
      montrerEtiquette(conteneur, null);
    });
  }

  /** Etiquette discrete en bas de carte, plutot qu'une bulle qui masque. */
  function montrerEtiquette(conteneur: HTMLElement, texte: string | null) {
    let bloc = conteneur.querySelector<HTMLElement>(".carte-etiquette");
    if (!texte) {
      bloc?.remove();
      return;
    }
    if (!bloc) {
      bloc = document.createElement("p");
      bloc.className = "carte-etiquette";
      conteneur.append(bloc);
    }
    bloc.textContent = texte;
  }

  async function dessiner(carte: any, voyage: string): Promise<number> {
    const reponse = await fetch(`/donnees/${voyage}/trace.geojson`);
    if (!reponse.ok) {
      throw new Error(`trace indisponible (HTTP ${reponse.status})`);
    }
    const trace = await reponse.json();
    carte.addSource("trace", { type: "geojson", data: trace });

    const lignes: any = [
      "all",
      ["==", ["geometry-type"], "LineString"],
    ];
    const epaisseur = ["interpolate", ["linear"], ["zoom"], 5, 3, 10, 5, 14, 7];

    // Un contour clair sous la trace. Le fond Positron est fait de traits
    // gris fins, frontieres et cours d'eau, dans lesquels une ligne coloree
    // se perd : ce halo lui degage sa place.
    carte.addLayer({
      id: "trace-contour",
      type: "line",
      source: "trace",
      filter: lignes,
      layout: { "line-cap": "round", "line-join": "round" },
      paint: {
        "line-color": "#ffffff",
        "line-opacity": 0.9,
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 6, 10, 9, 14, 12],
      },
    });

    carte.addLayer({
      id: "trace",
      type: "line",
      source: "trace",
      filter: lignes,
      layout: { "line-cap": "round", "line-join": "round" },
      paint: {
        // La couleur vient du mode, calculee par le pipeline (section 5.6).
        "line-color": ["get", "couleur"],
        "line-opacity": 0.95,
        "line-width": epaisseur,
      },
    });

    // Section 9.2 : les positions suspectes ne sont pas affichees par defaut.
    carte.addLayer({
      id: "photos",
      type: "circle",
      source: "trace",
      filter: [
        "all",
        ["==", ["geometry-type"], "Point"],
        ["==", ["get", "fiabilite"], "haute"],
      ],
      paint: {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 5, 2.5, 10, 4, 14, 6],
        "circle-color": "#c0562a",
        "circle-stroke-width": 1,
        "circle-stroke-color": "#ffffff",
        "circle-opacity": 0.9,
      },
    });

    const [[ouest, sud], [est, nord]] = emprise(trace);
    if (ouest > est || sud > nord) {
      throw new Error("trace sans geometrie exploitable");
    }
    poserCamps(carte, conteneur);
    rendreCliquable(carte, conteneur);

    carte.fitBounds(
      [
        [ouest, sud],
        [est, nord],
      ],
      { padding: 36, animate: false },
    );
    return trace.features?.length ?? 0;
  }

  /** Affiche l'echec dans le conteneur, plutot que dans la seule console. */
  function signaler(conteneur: HTMLElement, message: string) {
    conteneur.dataset.etat = "erreur";
    if (conteneur.querySelector(".carte-erreur")) return;
    const bloc = document.createElement("p");
    bloc.className = "carte-erreur";
    bloc.textContent = `La carte n'a pas pu s'afficher : ${message}`;
    conteneur.append(bloc);
    console.error("carte :", message);
  }

  const conteneurs = Array.from(document.querySelectorAll<HTMLElement>(".carte"));
  if (conteneurs.length > 0) {
    const observateur = new IntersectionObserver(
      (entrees) => {
        for (const entree of entrees) {
          if (!entree.isIntersecting) continue;
          observateur.unobserve(entree.target);
          const cible = entree.target as HTMLElement;
          afficher(cible).catch((erreur: unknown) => {
            signaler(cible, erreur instanceof Error ? erreur.message : String(erreur));
          });
        }
      },
      // Un peu d'avance, pour que la carte soit prête à l'arrivée du regard.
      { rootMargin: "300px" },
    );
    conteneurs.forEach((c) => observateur.observe(c));
  }
</script>

<style is:global>
  .carte {
    height: var(--hauteur, 60vh);
    width: 100%;
    border-radius: 3px;
    background: var(--trait);
    position: relative;
  }
  .carte-etiquette {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    z-index: 2;
    margin: 0;
    padding: 0.3rem 0.6rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.92);
    color: #2b2723;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.82rem;
    pointer-events: none;
    max-width: calc(100% - 6rem);
  }

  .carte-temoin,
  .carte-erreur,
  .carte noscript {
    position: absolute;
    inset: 0;
    /* MapLibre insere sa toile apres ces elements : sans cela, elle les
       recouvre et le message reste invisible sous la carte. */
    z-index: 2;
    pointer-events: none;
    margin: 0;
    background: color-mix(in srgb, var(--fond) 82%, transparent);
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
    color: var(--discret);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9rem;
  }
  .maplibregl-ctrl-attrib {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.7rem;
  }
</style>
