---
/**
 * Frise des journées, en haut de chaque page de journée.
 *
 * Vingt-trois cellules de largeur égale, chacune portant le numéro du jour,
 * ses kilomètres et une barre à la couleur de son mode dominant. Le carnet se
 * feuillette dans l'ordre, mais on veut aussi sauter au 8 août sans repasser
 * par la vue d'ensemble.
 *
 * Des liens, pas un script : la navigation marche sans JavaScript, au clavier
 * comme au doigt.
 *
 * La barre de couleur ne porte jamais seule son information : le mode est
 * écrit dans l'attribut `title` de chaque cellule, avec la date, le titre et
 * la distance.
 */
import { getCollection } from "astro:content";
import { jours as joursAgreges, type JourAgrege } from "../donnees";

interface Props {
  voyage: string;
  jour: string;
}
const { voyage, jour } = Astro.props;

const journees = await getCollection("journees", (e) => e.id.startsWith(`${voyage}/`));
journees.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const agreges = new Map<string, JourAgrege>(joursAgreges(voyage).map((j) => [j.jour, j]));

const iso = (d: Date) => d.toISOString().slice(0, 10);
const enFrancais = (d: Date) =>
  d.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long" });

const NOMS_MODE: Record<string, string> = {
  route: "route",
  marche: "marche",
  velo: "vélo",
  bateau: "bateau",
  train: "train",
  telepherique: "téléphérique",
};

// Les cellules portent le rang dans le voyage, non le jour du mois : « 24 25
// 26 … 1 2 3 » se lit mal, et la date complète est dans le fil au-dessus.
const etapes = journees.map((j, rang) => {
  const cle = iso(j.data.date);
  const agrege = agreges.get(cle);
  const mode = agrege?.mode_dominant ?? null;
  const km = Math.round(agrege?.distance_trace_km ?? 0);
  return {
    jour: cle,
    numero: String(rang + 1).padStart(2, "0"),
    titre: j.data.titre,
    km,
    mode,
    // Le titre de survol dit tout ce que la couleur ne dit pas.
    infobulle: [
      enFrancais(j.data.date),
      j.data.titre,
      mode ? NOMS_MODE[mode] ?? mode : null,
      km > 0 ? `${km} km` : null,
    ]
      .filter(Boolean)
      .join(" — "),
  };
});
---

<nav class="frise-jours" aria-label="Journées du voyage">
  <ol>
    {
      etapes.map((e) => (
        <li>
          <a
            href={`/voyages/${voyage}/jours/${e.jour}/`}
            aria-current={e.jour === jour ? "page" : undefined}
            title={e.infobulle}
          >
            <span class="numero chiffre">{e.numero}</span>
            <span class="km chiffre">{e.km > 0 ? e.km : ""}</span>
            <span
              class="barre"
              style={e.mode ? `background: var(--mode-${e.mode})` : "background: var(--rule)"}
            />
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .frise-jours {
    margin: 0 0 1.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .frise-jours ol {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .frise-jours li {
    /* `min-width: 0` est indispensable : sans lui, une cellule ne descend
       jamais sous la largeur de son texte et la page s'élargit. */
    flex: 1;
    min-width: 0;
  }
  .frise-jours a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    /* Quarante-quatre pixels de haut : la plus petite cible qui se vise au
       pouce sans effort. */
    min-height: 2.75rem;
    padding: 0.35rem 0.15rem 0;
    text-decoration: none;
    color: var(--muted);
    font-family: var(--sans);
    line-height: 1.1;
  }
  .frise-jours a:hover {
    color: var(--ink);
    background: var(--hl);
  }
  .frise-jours .numero {
    font-size: 13px;
  }
  .frise-jours .km {
    font-size: 10px;
    color: var(--faint);
    /* Les kilomètres sont arrondis à l'entier en amont : non arrondis, ils se
       coupent en plein milieu dès que la cellule passe sous 34 pixels. */
  }
  .frise-jours .barre {
    display: block;
    width: 100%;
    height: 3px;
    margin-top: 0.35rem;
  }
  .frise-jours [aria-current="page"] {
    color: var(--panel);
    background: var(--ink);
  }
  .frise-jours [aria-current="page"] .km {
    color: var(--panel);
    opacity: 0.7;
  }

  /* Sous 640 pixels, une cellule fait moins de trente pixels : il ne reste de
     la place que pour le numéro et la barre. */
  @media (max-width: 40rem) {
    .frise-jours .km {
      display: none;
    }
  }
</style>
