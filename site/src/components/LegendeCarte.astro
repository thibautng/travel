---
/**
 * Légende de la carte.
 *
 * La spec n'en prévoyait pas. Elle dit les modes de déplacement, seule
 * distinction que la carte porte encore : l'origine du tracé, mesuré ou
 * reconstitué, n'est plus rendue.
 *
 * Rien n'est codé en dur. Les modes, leurs couleurs et leurs kilomètres
 * viennent de la trace, et seuls ceux qui y figurent sont montrés : un
 * voyage sans bateau n'a pas à mentionner le bateau.
 */
import { legende } from "../donnees";

interface Props {
  voyage: string;
  /** Restreint la légende à une journée, sur la page de cette journée. */
  jour?: string;
}
const { voyage, jour } = Astro.props;
const { modes } = legende(voyage, jour);

const NOMS: Record<string, string> = {
  route: "Route",
  marche: "Marche",
  velo: "Vélo",
  bateau: "Bateau",
  train: "Train",
  telepherique: "Téléphérique",
};

---

<div class="legende">
  <ul class="modes">
    {
      modes.map((m) => (
        <li>
          <svg width="26" height="10" aria-hidden="true">
            <line x1="1" y1="5" x2="25" y2="5" style={`stroke: var(--mode-${m.cle})`} stroke-width="3" stroke-linecap="round" />
          </svg>
          <span>{NOMS[m.cle] ?? m.cle}</span>
          <span class="km">{m.km.toLocaleString("fr-FR")} km</span>
        </li>
      ))
    }
  </ul>

  <ul class="reperes">
    <li>
      <svg width="14" height="14" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5" fill="var(--ink)" stroke="var(--panel)" stroke-width="2" />
      </svg>
      <span>Camping</span>
    </li>
    <li>
      <svg width="14" height="14" aria-hidden="true">
        <circle cx="7" cy="7" r="3.5" fill="#ffffff" stroke="var(--ink)" stroke-width="1.4" />
      </svg>
      <span>Photo</span>
    </li>
    <li>
      <svg width="14" height="14" aria-hidden="true">
        <circle cx="7" cy="7" r="3.5" fill="#8c4a6b" stroke="var(--ink)" stroke-width="1.4" />
      </svg>
      <span>Vidéo</span>
    </li>
    <li>
      <svg width="14" height="14" aria-hidden="true">
        <circle cx="7" cy="7" r="3.5" fill="none" stroke="var(--muted)" stroke-width="1.4" />
      </svg>
      <span>Position reconstituée</span>
    </li>
  </ul>
</div>

<style>
  .legende {
    margin: 0.7rem 0 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0 0 0.4rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .km {
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }
  .reperes {
    padding-top: 0.45rem;
    border-top: 1px solid var(--trait);
  }
</style>
