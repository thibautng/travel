---
/**
 * Légende de la carte.
 *
 * La spec n'en prévoyait pas. Elle dit les modes de déplacement, seule
 * distinction que la carte porte encore : l'origine du tracé, mesuré ou
 * reconstitué, n'est plus rendue.
 *
 * Rien n'est codé en dur. Les modes, leurs couleurs et leurs kilomètres
 * viennent de la trace, et seuls ceux qui y figurent sont montrés : un
 * voyage sans bateau n'a pas à mentionner le bateau.
 */
import { legende } from "../donnees";

interface Props {
  voyage: string;
}
const { voyage } = Astro.props;
const { modes } = legende(voyage);

const NOMS: Record<string, string> = {
  route: "Route",
  marche: "Marche",
  velo: "Vélo",
  bateau: "Bateau",
  train: "Train",
  telepherique: "Téléphérique",
};

---

<div class="legende">
  <ul class="modes">
    {
      modes.map((m) => (
        <li>
          <svg width="26" height="10" aria-hidden="true">
            <line x1="1" y1="5" x2="25" y2="5" stroke={m.couleur} stroke-width="3" stroke-linecap="round" />
          </svg>
          <span>{NOMS[m.cle] ?? m.cle}</span>
          <span class="km">{m.km.toLocaleString("fr-FR")} km</span>
        </li>
      ))
    }
  </ul>

  <p class="note">
    Seules les positions fiables sont marquées d'une pastille. Les positions
    approximatives restent dans les données sans être portées sur la carte.
  </p>
</div>

<style>
  .legende {
    margin: 0.7rem 0 0;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.82rem;
    color: var(--discret);
  }
  ul {
    list-style: none;
    margin: 0 0 0.4rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .km {
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }
  .note {
    margin: 0.5rem 0 0;
    padding-top: 0.45rem;
    border-top: 1px solid var(--trait);
    opacity: 0.85;
    max-width: 40rem;
  }
</style>
