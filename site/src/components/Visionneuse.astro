---
/**
 * Agrandissement des photos. Voir SPEC.md, section 9.4.
 *
 * Le composant ne connaît aucune photo : il ramasse au chargement tout ce qui
 * porte un attribut `data-grand`, dans l'ordre du document. Les pages n'ont
 * donc rien à lui déclarer, et une galerie ajoutée demain fonctionnera sans
 * qu'il change.
 *
 * S'appuie sur `<dialog>` natif : l'échappement, le fond assombri et le
 * piège de focus sont gratuits, ce qui laisse le script à l'essentiel, la
 * navigation d'une photo à l'autre.
 */
---

<dialog id="visionneuse" aria-label="Photo agrandie">
  <img alt="" />
  <button class="fermer" type="button" aria-label="Fermer">&times;</button>
  <button class="precedente" type="button" aria-label="Photo précédente">&lsaquo;</button>
  <button class="suivante" type="button" aria-label="Photo suivante">&rsaquo;</button>
</dialog>

<script>
  const dialogue = document.getElementById("visionneuse") as HTMLDialogElement | null;
  const image = dialogue?.querySelector("img");
  const vignettes = Array.from(
    document.querySelectorAll<HTMLElement>("[data-grand]"),
  );

  if (dialogue && image && vignettes.length > 0) {
    let rang = 0;

    const montrer = (n: number) => {
      rang = (n + vignettes.length) % vignettes.length;
      image.src = vignettes[rang].dataset.grand ?? "";
      const seule = vignettes.length < 2;
      dialogue.classList.toggle("seule", seule);
    };

    vignettes.forEach((vignette, i) => {
      vignette.classList.add("agrandissable");
      vignette.addEventListener("click", () => {
        montrer(i);
        dialogue.showModal();
      });
    });

    dialogue.querySelector(".fermer")?.addEventListener("click", () => dialogue.close());
    dialogue.querySelector(".precedente")?.addEventListener("click", () => montrer(rang - 1));
    dialogue.querySelector(".suivante")?.addEventListener("click", () => montrer(rang + 1));

    // Un clic sur le fond ferme. Le dialogue occupe tout l'écran, donc la
    // cible n'est le dialogue lui-même que hors de l'image et des boutons.
    dialogue.addEventListener("click", (evenement) => {
      if (evenement.target === dialogue) dialogue.close();
    });

    document.addEventListener("keydown", (evenement) => {
      if (!dialogue.open) return;
      if (evenement.key === "ArrowLeft") montrer(rang - 1);
      if (evenement.key === "ArrowRight") montrer(rang + 1);
    });

    // Balayage au doigt, le geste attendu sur téléphone.
    let depart: number | null = null;
    dialogue.addEventListener(
      "touchstart",
      (evenement) => {
        depart = evenement.changedTouches[0].clientX;
      },
      { passive: true },
    );
    dialogue.addEventListener(
      "touchend",
      (evenement) => {
        if (depart === null) return;
        const delta = evenement.changedTouches[0].clientX - depart;
        if (Math.abs(delta) > 50) montrer(rang + (delta < 0 ? 1 : -1));
        depart = null;
      },
      { passive: true },
    );
  }
</script>

<style is:global>
  .agrandissable {
    cursor: zoom-in;
  }

  #visionneuse {
    border: 0;
    padding: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    background: transparent;
    overflow: hidden;
  }
  #visionneuse::backdrop {
    background: rgba(12, 10, 8, 0.92);
  }
  #visionneuse img {
    position: absolute;
    inset: 0;
    margin: auto;
    max-width: 96vw;
    max-height: 92vh;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  #visionneuse button {
    position: absolute;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    border: 0;
    border-radius: 50%;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  #visionneuse button:hover {
    background: rgba(0, 0, 0, 0.7);
  }
  #visionneuse .fermer {
    top: 0.8rem;
    right: 0.8rem;
  }
  #visionneuse .precedente {
    left: 0.6rem;
    top: 50%;
    transform: translateY(-50%);
  }
  #visionneuse .suivante {
    right: 0.6rem;
    top: 50%;
    transform: translateY(-50%);
  }
  #visionneuse.seule .precedente,
  #visionneuse.seule .suivante {
    display: none;
  }
</style>
