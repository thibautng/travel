---
/**
 * Gabarit commun. Voir SPEC.md, section 9.5 : le sujet, ce sont les photos
 * et le texte, pas l'interface. Le style complet arrive au commit 5 ; ici,
 * seulement de quoi lire confortablement.
 */
interface Props {
  titre: string;
  description?: string;
  /** `large` élargit la colonne pour la mise en page à deux colonnes (9.3). */
  gabarit?: "texte" | "large";
  /** Miettes du fil, après « Voyages ». Chacune peut porter un lien. */
  fil?: { texte: string; href?: string }[];
  /** Repère aligné à droite du fil, du type « Jour 16 sur 23 ». */
  repere?: string;
}
const { titre, description, gabarit = "texte", fil = [], repere } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titre}</title>
    {description && <meta name="description" content={description} />}
    <style is:global>
      @import "../fontes.css";
    </style>
    <style>
      /* Jetons de la direction « Le cartographe ». Les anciens noms français
         restent comme alias : une centaine de règles les emploient encore, et
         les renommer d’un coup mélangerait deux travaux dans le même commit. */
      :root {
        color-scheme: light dark;
        --bg: #f2f3ef;
        --panel: #ffffff;
        --ink: #1e2422;
        --muted: #6b7370;
        --faint: #8b918d;
        --rule: #dcdfd8;
        --accent: #d1491f;
        --hl: #f7f2ee;
        --map: #eaece7;
        --grid: #dfe2dc;

        /* Modes de déplacement. Hors palette d’interface, et lus par la carte
           depuis ces variables : codés en dur, ils ne pourraient pas changer
           avec le thème. */
        --mode-route: #4a3b2e;
        --mode-marche: #d1491f;
        --mode-velo: #2e7d32;
        --mode-train: #8e24aa;
        --mode-bateau: #1565c0;
        --mode-telepherique: #b08300;

        --fond: var(--bg);
        --encre: var(--ink);
        --discret: var(--muted);
        --trait: var(--rule);

        --serif: "IBM Plex Serif", ui-serif, Georgia, serif;
        --sans: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", monospace;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #14181a;
          --panel: #1b2124;
          --ink: #e6e9e5;
          --muted: #9aa29d;
          --faint: #79817d;
          --rule: #2b3235;
          --accent: #e8683c;
          --hl: #241f1d;
          --map: #1b2124;
          --grid: #242c2f;

          /* Mêmes teintes, luminosité inversée : un brun à #4a3b2e sur fond
             sombre tombe à 1,3:1 et la route disparaît. */
          --mode-route: #b6a692;
          --mode-marche: #f0714a;
          --mode-velo: #5fae63;
          --mode-train: #c07ad6;
          --mode-bateau: #5aa0e6;
          --mode-telepherique: #d8ae3d;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--fond);
        color: var(--encre);
        font: 19px/1.72 var(--serif);
        font-synthesis: none;
      }
      main {
        max-width: 46rem;
        margin: 0 auto;
        padding: 2rem 1.25rem 6rem;
      }
      main[data-gabarit="large"] {
        max-width: 76rem;
      }
      a {
        color: var(--accent);
      }
      h1,
      h2,
      h3 {
        font-family: var(--serif);
        line-height: 1.06;
        letter-spacing: -0.022em;
        font-weight: 400;
      }
      h1 {
        font-size: clamp(2rem, 1.4rem + 2.2vw, 2.875rem);
        margin: 0 0 0.3rem;
      }
      .discret {
        color: var(--muted);
        font-family: var(--sans);
        font-size: 13px;
        font-weight: 500;
      }
      /* Tous les chiffres du site sont en mono : dates courtes, kilomètres,
         compteurs. Une colonne de nombres doit s’aligner. */
      .chiffre {
        font-family: var(--mono);
        font-variant-numeric: tabular-nums;
      }
      nav.fil {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1px solid var(--rule);
        padding: 0.9rem 1.25rem;
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
      }
      nav.fil .miettes {
        display: flex;
        align-items: baseline;
        gap: 0.55rem;
        min-width: 0;
        overflow: hidden;
        white-space: nowrap;
      }
      nav.fil a {
        text-decoration: none;
        color: var(--muted);
      }
      nav.fil a:hover {
        color: var(--ink);
      }
      nav.fil .separateur {
        color: var(--faint);
      }
      nav.fil .repere {
        flex: none;
        color: var(--faint);
        text-transform: none;
        letter-spacing: 0;
      }

      @media (min-width: 48rem) {
        main {
          padding: 3rem 2rem 8rem;
        }
      }

      /* Section 9.3, mise en page à deux colonnes.
         Une colonne jusqu’à 1024 pixels, où la carte est un bandeau collant en
         haut de l’écran ; deux colonnes au-delà, carte fixe à droite. Le seuil
         est celui de la spec, exprimé en rem : 64rem valent 1024 pixels à la
         taille de police par défaut, et suivent l’utilisateur qui l’augmente. */
      .deux-colonnes {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem 2.5rem;
      }
      /* Le récit passe avant la carte dans le document : c’est lui qu’on lit,
         et un lecteur d’écran doit le rencontrer d’abord. En une colonne, la
         grille remet la carte en tête pour qu’elle soit le bandeau collant du
         haut, et non un bandeau collant au bas de la page. */
      .deux-colonnes > .colonne-carte {
        grid-row: 1;
      }
      /* Sur téléphone la carte passe devant le récit et s’y colle : c’est le
         bandeau de la section 9.3, dont le récit défile dessous. */
      .deux-colonnes > .colonne-carte {
        position: sticky;
        top: 0;
        z-index: 1;
        /* Le fond évite que le texte transparaisse derrière le bandeau au
           moment où il glisse dessous. */
        background: var(--fond);
        padding-bottom: 0.5rem;
        margin-inline: -1.25rem;
        padding-inline: 1.25rem;
      }
      .deux-colonnes > .colonne-carte .carte {
        --hauteur: 30vh;
      }
      @media (min-width: 48rem) {
        .deux-colonnes > .colonne-carte .carte {
          --hauteur: 38vh;
        }
      }
      @media (min-width: 64rem) {
        .deux-colonnes {
          /* 45 % à la carte, le reste au récit (9.3). */
          grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
          align-items: start;
        }
        .deux-colonnes > .colonne-recit {
          grid-column: 1;
          grid-row: 1;
        }
        .deux-colonnes > .colonne-carte {
          /* Deux colonnes : la carte reprend sa place à droite, sur la
             première ligne comme le récit. */
          grid-column: 2;
          grid-row: 1;
          top: 1.5rem;
          margin-inline: 0;
          padding-inline: 0;
          padding-bottom: 0;
        }
        .deux-colonnes > .colonne-carte .carte {
          --hauteur: calc(100vh - 3rem);
        }
      }

      p {
        text-wrap: pretty;
      }
      h1,
      h2,
      h3 {
        text-wrap: balance;
      }
      img {
        max-width: 100%;
      }

      /* La hauteur est posée ici, dans la feuille du gabarit, présente dès le
         <head>. Laissée au seul composant, elle pouvait arriver après le
         script, et MapLibre construisait alors une toile de hauteur nulle. */
      .carte {
        height: var(--hauteur, 60vh);
        min-height: 18rem;
        width: 100%;
      }

      footer {
        border-top: 1px solid var(--trait);
        margin-top: 4rem;
        padding: 1.5rem 1.25rem 3rem;
        text-align: center;
        color: var(--muted);
        font-family: var(--sans);
        font-size: 13px;
      }

      /* Le lien est visible au clavier, y compris sur les vignettes. */
      a:focus-visible,
      button:focus-visible,
      [data-grand]:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <nav class="fil" aria-label="Fil d’Ariane">
      <span class="miettes">
        <a href="/">Voyages</a>
        {fil.map((m) => (
          <>
            <span class="separateur" aria-hidden="true">/</span>
            {m.href ? <a href={m.href}>{m.texte}</a> : <span>{m.texte}</span>}
          </>
        ))}
      </span>
      {repere && <span class="repere chiffre">{repere}</span>}
    </nav>
    <main data-gabarit={gabarit}>
      <slot />
    </main>
    <footer>Journal de voyage de la famille. Lien privé, page non indexée.</footer>
  </body>
</html>
