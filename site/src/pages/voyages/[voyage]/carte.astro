---
/**
 * Lecteur jour par jour. Voir SPEC.md, section 9.2, deuxième mode.
 *
 * La carte occupe l'écran, un curseur fait défiler les journées, et la carte
 * recentre sur celle qu'on lit. Le critère de fin du lot 5 est qu'il
 * fonctionne au doigt sur téléphone : d'où un curseur natif, deux boutons
 * larges, et aucune interaction qui demande un survol.
 *
 * Le pilotage passe par un évènement poussé sur le conteneur de la carte.
 * Le lecteur ne sait rien de MapLibre, la carte ne sait rien du curseur.
 */
import Page from "../../../layouts/Page.astro";
import Carte from "../../../components/Carte.astro";
import LegendeCarte from "../../../components/LegendeCarte.astro";
import { tousLesVoyages, type Voyage } from "../../../voyages";
import { jours, type JourAgrege } from "../../../donnees";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return tousLesVoyages().map((v) => ({ params: { voyage: v.id }, props: { v } }));
}

interface Props {
  v: Voyage;
}
const { v } = Astro.props;

const journees = await getCollection("journees", (e) => e.id.startsWith(`${v.id}/`));
journees.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const agreges = new Map<string, JourAgrege>(jours(v.id).map((j) => [j.jour, j]));

const iso = (d: Date) => d.toISOString().slice(0, 10);
const enFrancais = (d: Date) =>
  d.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long" });

// Tout ce dont le curseur a besoin, sérialisé une fois : vingt-trois entrées
// pèsent moins qu'une requête, et le lecteur doit répondre au doigt sans
// attendre le réseau.
const etapes = journees.map((j) => {
  const jour = iso(j.data.date);
  const agrege = agreges.get(jour);
  return {
    jour,
    titre: j.data.titre,
    date: enFrancais(j.data.date),
    km: agrege?.distance_trace_km ?? 0,
    medias: agrege?.medias.total ?? 0,
  };
});
---

<Page titre={`Carte du voyage — ${v.titre}`} description={v.sous_titre}>
  <h1>Jour par jour</h1>
  <p class="discret">
    <a href={`/voyages/${v.id}/`}>{v.titre}</a>
  </p>

  <div class="lecteur" data-etapes={JSON.stringify(etapes)}>
    <Carte voyage={v.id} vue="ensemble" hauteur="58vh" />

    <div class="barre">
      <button type="button" class="fleche" data-pas="-1" aria-label="Journée précédente">
        <span aria-hidden="true">‹</span>
      </button>

      <div class="etape" aria-live="polite">
        <span class="date discret" data-champ="date">Tout le voyage</span>
        <a class="titre" data-champ="titre" href={`/voyages/${v.id}/`}>
          {etapes.length} journées
        </a>
        <span class="chiffres discret" data-champ="chiffres"></span>
      </div>

      <button type="button" class="fleche" data-pas="1" aria-label="Journée suivante">
        <span aria-hidden="true">›</span>
      </button>
    </div>

    <label class="curseur">
      <span class="visuellement-cache">Journée</span>
      <input
        type="range"
        min="0"
        max={etapes.length}
        value="0"
        step="1"
        data-role="curseur"
      />
    </label>

    <p class="aide discret">
      Le curseur à zéro montre le voyage entier. Les journées défilent ensuite
      dans l’ordre.
    </p>
  </div>

  <LegendeCarte voyage={v.id} />
</Page>

<script>
  interface Etape {
    jour: string;
    titre: string;
    date: string;
    km: number;
    medias: number;
  }

  function equiper(lecteur: HTMLElement) {
    const etapes: Etape[] = JSON.parse(lecteur.dataset.etapes ?? "[]");
    const carte = lecteur.querySelector<HTMLElement>(".carte");
    const curseur = lecteur.querySelector<HTMLInputElement>('[data-role="curseur"]');
    if (!carte || !curseur || etapes.length === 0) return;

    const champ = (nom: string) => lecteur.querySelector<HTMLElement>(`[data-champ="${nom}"]`);
    const voyage = carte.dataset.voyage!;

    // Position zéro : le voyage entier. Les journées commencent à un, ce qui
    // évite un mode « aucune sélection » distinct du reste.
    //
    // Fonction fléchée et non déclaration : une déclaration est hissée, et
    // TypeScript perd alors la garde de nullité posée juste au-dessus.
    const afficher = (rang: number) => {
      const etape = rang === 0 ? null : etapes[rang - 1];
      carte.dispatchEvent(
        new CustomEvent("carte:jour", { detail: { jour: etape?.jour ?? null } }),
      );

      const date = champ("date");
      const titre = champ("titre");
      const chiffres = champ("chiffres");
      if (date) date.textContent = etape ? etape.date : "Tout le voyage";
      if (titre) {
        titre.textContent = etape ? etape.titre : `${etapes.length} journées`;
        titre.setAttribute(
          "href",
          etape ? `/voyages/${voyage}/jours/${etape.jour}/` : `/voyages/${voyage}/`,
        );
      }
      if (chiffres) {
        chiffres.textContent = etape
          ? [
              etape.medias > 0 ? `${etape.medias} médias` : null,
              etape.km > 0 ? `${etape.km.toLocaleString("fr-FR")} km` : null,
            ]
              .filter(Boolean)
              .join(" · ")
          : "";
      }
    };

    curseur.addEventListener("input", () => afficher(Number(curseur.value)));

    for (const bouton of lecteur.querySelectorAll<HTMLButtonElement>(".fleche")) {
      bouton.addEventListener("click", () => {
        const pas = Number(bouton.dataset.pas ?? 0);
        const vise = Math.min(etapes.length, Math.max(0, Number(curseur.value) + pas));
        curseur.value = String(vise);
        afficher(vise);
      });
    }

    // Les flèches du clavier pilotent le lecteur même hors du curseur : la
    // page n'a rien d'autre à faire défiler horizontalement.
    lecteur.addEventListener("keydown", (evenement) => {
      const touche = (evenement as KeyboardEvent).key;
      if (touche !== "ArrowLeft" && touche !== "ArrowRight") return;
      if (document.activeElement === curseur) return;
      const pas = touche === "ArrowRight" ? 1 : -1;
      const vise = Math.min(etapes.length, Math.max(0, Number(curseur.value) + pas));
      curseur.value = String(vise);
      afficher(vise);
    });

    // Une date dans l'adresse ouvre le lecteur dessus : c'est ce qui rend un
    // lien vers une journée partageable.
    const demandee = new URLSearchParams(location.search).get("jour");
    const rang = demandee ? etapes.findIndex((e) => e.jour === demandee) + 1 : 0;
    if (rang > 0) {
      curseur.value = String(rang);
      afficher(rang);
    }
  }

  for (const lecteur of document.querySelectorAll<HTMLElement>(".lecteur")) {
    equiper(lecteur);
  }
</script>

<style>
  .lecteur {
    margin: 1.5rem 0 0;
  }
  .barre {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.9rem;
  }
  .fleche {
    flex: none;
    /* Quarante-quatre pixels : la cible tactile la plus petite qui se vise
       sans effort au pouce. */
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--trait);
    border-radius: 50%;
    background: transparent;
    color: var(--encre);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .fleche:hover {
    border-color: var(--discret);
  }
  .etape {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-align: center;
  }
  .etape .titre {
    color: var(--encre);
    text-decoration: none;
    font-family: ui-sans-serif, system-ui, sans-serif;
    text-wrap: balance;
  }
  .etape .titre:hover {
    text-decoration: underline;
  }
  .etape .date {
    font-size: 0.8rem;
  }
  .etape .chiffres {
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .curseur {
    display: block;
    margin-top: 0.7rem;
  }
  .curseur input {
    width: 100%;
    /* La piste native est trop fine pour le doigt ; celle-ci fait le double
       et garde le curseur natif, qui sait deja repondre au tactile. */
    height: 2rem;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .aide {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
  }
  .visuellement-cache {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
