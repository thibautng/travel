---
/**
 * Une journée : le récit, sa mini-carte et sa galerie. Voir SPEC.md,
 * sections 9.1 et 9.2, troisième mode.
 */
import Page from "../../../../layouts/Page.astro";
import Visionneuse from "../../../../components/Visionneuse.astro";
import Carte from "../../../../components/Carte.astro";
import { tousLesVoyages, lieu, type Voyage } from "../../../../voyages";
import { mediasDuJour, urlMedia, type Media } from "../../../../donnees";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const chemins = [];
  for (const v of tousLesVoyages()) {
    const journees = await getCollection("journees", (e) => e.id.startsWith(`${v.id}/`));
    journees.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
    for (const [rang, journee] of journees.entries()) {
      chemins.push({
        params: { voyage: v.id, jour: journee.data.date.toISOString().slice(0, 10) },
        props: {
          v,
          journee,
          precedente: journees[rang - 1],
          suivante: journees[rang + 1],
        },
      });
    }
  }
  return chemins;
}

interface Props {
  v: Voyage;
  journee: CollectionEntry<"journees">;
  precedente?: CollectionEntry<"journees">;
  suivante?: CollectionEntry<"journees">;
}
const { v, journee, precedente, suivante } = Astro.props;
const { Content } = await render(journee);

const jour = journee.data.date.toISOString().slice(0, 10);
const photos: Media[] = mediasDuJour(v.id, jour).filter((m) => m.type === "photo" && m.derives);
const camp = lieu(v, journee.data.camp);

const enFrancais = (d: Date) =>
  d.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
const lien = (e: CollectionEntry<"journees">) =>
  `/voyages/${v.id}/jours/${e.data.date.toISOString().slice(0, 10)}/`;
---

<Page titre={`${journee.data.titre} — ${v.titre}`} gabarit="large">
  <div class="deux-colonnes" data-journee={jour}>
    <div class="colonne-recit">
      <p class="discret">
        <a href={`/voyages/${v.id}/`}>{v.titre}</a>
      </p>
      <h1>{journee.data.titre}</h1>
      <p class="discret">
        {enFrancais(journee.data.date)}
        {camp && ` · ${camp.nom}`}
      </p>

      <article>
        <Content />
      </article>

      {
        photos.length > 0 && (
          <section class="galerie">
            <h2>Les photos du jour</h2>
            <div class="grille">
              {photos.map((photo) => (
                <img
                  src={urlMedia(photo.derives!.moyen, v.id)}
                  srcset={`${urlMedia(photo.derives!.vignette, v.id)} 320w, ${urlMedia(photo.derives!.moyen, v.id)} 1024w, ${urlMedia(photo.derives!.grand, v.id)} 2048w`}
                  sizes="(min-width: 64rem) 16rem, (min-width: 48rem) 22rem, 45vw"
                  width={photo.largeur}
                  height={photo.hauteur}
                  data-grand={urlMedia(photo.derives!.grand, v.id)}
                  data-media={photo.id}
                  loading="lazy"
                  decoding="async"
                  alt=""
                  style={photo.lqip ? `background-image:url(${photo.lqip});background-size:cover` : undefined}
                />
              ))}
            </div>
          </section>
        )
      }

      <nav class="voisines">
        {precedente ? <a href={lien(precedente)}>← {precedente.data.titre}</a> : <span />}
        {suivante ? <a href={lien(suivante)}>{suivante.data.titre} →</a> : <span />}
      </nav>
    </div>

    <div class="colonne-carte">
      <Carte voyage={v.id} vue="jour" jour={jour} />
      <p class="sous-carte discret">
        <a href={`/voyages/${v.id}/carte/?jour=${jour}`}>Voir cette journée dans le lecteur</a>
      </p>
    </div>
  </div>
  <Visionneuse />
</Page>

<script>
  /**
   * Section 9.2, troisième mode : le récit et la carte se suivent.
   *
   * Dans un sens, cliquer une pastille amène à la photo. Dans l’autre, la
   * photo que l’on est en train de lire s’entoure d’un anneau sur la carte.
   */
  function synchroniser(bloc: HTMLElement) {
    const carte = bloc.querySelector<HTMLElement>(".carte");
    const images = Array.from(bloc.querySelectorAll<HTMLElement>("[data-media]"));
    if (!carte || images.length === 0) return;

    const parIdentifiant = new Map(images.map((i) => [i.dataset.media!, i]));

    // Carte vers récit.
    carte.addEventListener("carte:media", (evenement) => {
      const cible = parIdentifiant.get((evenement as CustomEvent).detail?.id);
      if (!cible) return;
      cible.scrollIntoView({ behavior: "smooth", block: "center" });
      cible.classList.add("designee");
      window.setTimeout(() => cible.classList.remove("designee"), 1600);
    });

    // Récit vers carte. Un observateur plutôt qu’un écouteur de défilement :
    // le navigateur ne réveille le script que lorsqu’une image entre ou sort,
    // et la page ne calcule rien pendant qu’on lit.
    let visibles = new Set<HTMLElement>();
    let actif = "";

    const designerLaPlusCentree = () => {
      if (visibles.size === 0) return;
      const milieu = window.innerHeight / 2;
      let meilleure: HTMLElement | null = null;
      let ecartMinimal = Infinity;
      for (const image of visibles) {
        const boite = image.getBoundingClientRect();
        const ecart = Math.abs(boite.top + boite.height / 2 - milieu);
        if (ecart < ecartMinimal) {
          ecartMinimal = ecart;
          meilleure = image;
        }
      }
      const identifiant = meilleure?.dataset.media ?? "";
      if (identifiant === actif) return;
      actif = identifiant;
      carte.dispatchEvent(
        new CustomEvent("carte:media-actif", { detail: { id: identifiant } }),
      );
    };

    const observateur = new IntersectionObserver(
      (entrees) => {
        for (const entree of entrees) {
          const image = entree.target as HTMLElement;
          if (entree.isIntersecting) visibles.add(image);
          else visibles.delete(image);
        }
        designerLaPlusCentree();
      },
      // La bande centrale de l’écran : une image qui pointe en bas de page
      // n’est pas celle qu’on lit.
      { rootMargin: "-30% 0px -30% 0px" },
    );
    for (const image of images) observateur.observe(image);

    // Le défilement continu ne déclenche pas l’observateur : sans cela,
    // l’anneau resterait sur la première image tant qu’aucune autre n’entre.
    let attente = 0;
    window.addEventListener(
      "scroll",
      () => {
        if (attente) return;
        attente = window.requestAnimationFrame(() => {
          attente = 0;
          designerLaPlusCentree();
        });
      },
      { passive: true },
    );
  }

  for (const bloc of document.querySelectorAll<HTMLElement>(".deux-colonnes")) {
    synchroniser(bloc);
  }
</script>

<style>
  /* L’image que la carte vient de désigner, le temps qu’on la retrouve. */
  .colonne-recit :global([data-media].designee) {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .sous-carte {
    margin: 0.5rem 0 1.6rem;
    text-align: right;
    font-size: 0.82rem;
  }
  article :global(p) {
    margin: 1.1rem 0;
  }
  article :global(em) {
    color: var(--discret);
  }

  /* Directives du récit, résolues au build par src/directives.ts. Les
     photos débordent de la colonne de texte sur grand écran : le sujet du
     site, ce sont les images, pas la justification. */
  article :global(figure.photo) {
    margin: 2rem 0;
  }
  article :global(figure.photo img) {
    width: 100%;
    height: auto;
    border-radius: 2px;
    background-color: var(--trait);
  }
  article :global(figure.photo figcaption) {
    margin-top: 0.5rem;
    color: var(--discret);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.88rem;
  }
  article :global(.galerie) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0.5rem;
    margin: 2rem 0;
  }
  article :global(.galerie img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 2px;
    background-color: var(--trait);
  }
  article :global(video) {
    width: 100%;
    height: auto;
    margin: 2rem 0;
  }
  article :global(.video-en-attente) {
    color: var(--discret);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9rem;
    border-left: 2px solid var(--trait);
    padding-left: 0.8rem;
  }
  .galerie {
    margin-top: 3rem;
  }
  .grille {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 0.6rem;
  }
  .grille img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 2px;
    background-color: var(--trait);
  }
  .voisines {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--trait);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9rem;
  }
  .voisines a {
    text-decoration: none;
    max-width: 45%;
  }
</style>
