---
/**
 * Toutes les photos retenues du voyage, groupées par jour.
 * Voir SPEC.md, section 9.1 : « toutes les photos » s'entend au sens de
 * toutes les photos retenues, la sélection relevant de D7.
 *
 * Les aperçus inline sont volontairement absents ici, alors que les pages de
 * journée les portent. À 965 octets pièce, 705 aperçus faisaient à eux seuls
 * 680 Ko de HTML sur cette page. Les vignettes de 320 pixels arrivent assez
 * vite pour s'en passer, ce qui n'est pas le cas des grandes images du récit.
 */
import Page from "../../../layouts/Page.astro";
import Visionneuse from "../../../components/Visionneuse.astro";
import { tousLesVoyages, type Voyage } from "../../../voyages";
import { medias, urlMedia, type Media } from "../../../donnees";

export async function getStaticPaths() {
  return tousLesVoyages().map((v) => ({ params: { voyage: v.id }, props: { v } }));
}

interface Props {
  v: Voyage;
}
const { v } = Astro.props;

const parJour = new Map<string, Media[]>();
for (const media of medias(v.id)) {
  if (media.type !== "photo" || !media.publie || !media.derives || !media.jour) continue;
  const liste = parJour.get(media.jour) ?? [];
  liste.push(media);
  parJour.set(media.jour, liste);
}
const groupes = [...parJour.entries()].sort(([a], [b]) => a.localeCompare(b));
for (const [, liste] of groupes) {
  liste.sort((a, b) => (a.prise_le ?? "").localeCompare(b.prise_le ?? ""));
}
const total = groupes.reduce((t, [, liste]) => t + liste.length, 0);

const enFrancais = (jour: string) =>
  new Date(`${jour}T12:00:00Z`).toLocaleDateString("fr-FR", {
    weekday: "long",
    day: "numeric",
    month: "long",
  });
---

<Page
  titre={`Photos — ${v.titre}`}
  gabarit="large"
  fil={[{ texte: v.titre, href: `/voyages/${v.id}/` }, { texte: "Photos" }]}
  repere={`${total} photos`}
>
  <h1>Photos</h1>
  <p class="meta chiffre">{total} photos · {groupes.length} journées</p>

  <nav class="index" aria-label="Aller à une journée">
    {
      groupes.map(([jour, liste], rang) => (
        <a href={`#j${jour}`}>
          <span class="chiffre numero">{String(rang + 1).padStart(2, "0")}</span>
          <span class="chiffre compte">{liste.length}</span>
        </a>
      ))
    }
  </nav>

  {
    groupes.map(([jour, liste]) => (
      <section id={`j${jour}`}>
        <h2>
          <a href={`/voyages/${v.id}/jours/${jour}/`}>{enFrancais(jour)}</a>
          <span class="chiffre compte">{liste.length}</span>
        </h2>
        <div class="grille">
          {liste.map((photo) => (
            <img
              src={urlMedia(photo.derives!.vignette, v.id)}
              srcset={`${urlMedia(photo.derives!.vignette, v.id)} 320w, ${urlMedia(photo.derives!.moyen, v.id)} 1024w`}
              sizes="(min-width: 48rem) 11rem, 30vw"
              width={photo.largeur}
              height={photo.hauteur}
              data-grand={urlMedia(photo.derives!.grand, v.id)}
              loading="lazy"
              decoding="async"
              alt=""
            />
          ))}
        </div>
      </section>
    ))
  }
  <Visionneuse />
</Page>

<style>
  .meta {
    margin: 0.55rem 0 1.6rem;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* L’index des journées, en tête : sept cents vignettes font une page longue,
     et l’on veut atteindre le 8 août sans la parcourir. */
  .index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-bottom: 2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--rule);
  }
  .index a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--rule);
    color: var(--muted);
    text-decoration: none;
    line-height: 1.15;
  }
  .index a:hover {
    border-color: var(--accent);
    color: var(--ink);
  }
  .index .numero {
    font-size: 13px;
  }
  .index .compte {
    font-size: 10px;
    color: var(--faint);
  }

  section {
    scroll-margin-top: 3.2rem;
  }
  /* L’en-tête reste sous les yeux pendant qu’on parcourt les vignettes du
     jour : sans lui, on ne sait plus où l’on est. */
  h2 {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 2.4rem 0 0.7rem;
    padding: 0.5rem 0;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
  }
  h2 a {
    text-decoration: none;
    color: var(--ink);
  }
  h2 .compte {
    font-size: 12px;
    color: var(--faint);
  }
  .grille {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 7.5rem), 1fr));
    gap: 2px;
  }
  .grille img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background-color: var(--rule);
  }
</style>
